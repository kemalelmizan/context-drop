<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>ContextDrop — Feedback Triage Dashboard</title>
  <%= csrf_meta_tags if respond_to?(:csrf_meta_tags) %>
  <style>
    :root {
      --cd-bg: #f8fafc;
      --cd-surface: #ffffff;
      --cd-border: #e2e8f0;
      --cd-text: #0f172a;
      --cd-muted: #64748b;
      --cd-primary: #2563eb;
      --cd-primary-hover: #1d4ed8;
      --cd-new-bg: #dbeafe;
      --cd-new-text: #1e40af;
      --cd-reviewed-bg: #fef3c7;
      --cd-reviewed-text: #92400e;
      --cd-resolved-bg: #dcfce7;
      --cd-resolved-text: #166534;
      --cd-dismissed-bg: #f1f5f9;
      --cd-dismissed-text: #475569;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background: var(--cd-bg);
      color: var(--cd-text);
      line-height: 1.5;
    }
    .cd-header {
      background: var(--cd-surface);
      border-bottom: 1px solid var(--cd-border);
      padding: 0.875rem 1.5rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .cd-brand {
      font-weight: 700;
      font-size: 1.125rem;
      color: var(--cd-text);
      text-decoration: none;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .cd-brand-badge {
      font-size: 0.75rem;
      font-weight: 600;
      padding: 0.125rem 0.5rem;
      border-radius: 9999px;
      background: var(--cd-new-bg);
      color: var(--cd-new-text);
    }
    .cd-container {
      max-width: 1200px;
      margin: 1.5rem auto;
      padding: 0 1.5rem;
    }
    .cd-flash {
      padding: 0.75rem 1rem;
      border-radius: 0.5rem;
      margin-bottom: 1rem;
      font-size: 0.875rem;
      border: 1px solid var(--cd-border);
      background: var(--cd-surface);
    }
    .cd-flash-notice { border-color: #86efac; background: #f0fdf4; color: #166534; }
    .cd-flash-alert { border-color: #fca5a5; background: #fef2f2; color: #991b1b; }
    .cd-card {
      background: var(--cd-surface);
      border: 1px solid var(--cd-border);
      border-radius: 0.75rem;
      padding: 1.25rem;
      margin-bottom: 1.25rem;
      box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
    }
    .cd-tabs {
      display: flex;
      gap: 0.5rem;
      flex-wrap: wrap;
      margin-bottom: 1rem;
    }
    .cd-tab {
      display: inline-flex;
      align-items: center;
      gap: 0.375rem;
      padding: 0.4rem 0.85rem;
      border-radius: 0.5rem;
      font-size: 0.875rem;
      font-weight: 500;
      color: var(--cd-muted);
      text-decoration: none;
      border: 1px solid transparent;
    }
    .cd-tab:hover { background: #f1f5f9; color: var(--cd-text); }
    .cd-tab.active {
      background: var(--cd-surface);
      color: var(--cd-primary);
      border-color: var(--cd-border);
      font-weight: 600;
    }
    .cd-filter-bar {
      display: flex;
      gap: 0.75rem;
      flex-wrap: wrap;
      margin-bottom: 1rem;
    }
    .cd-input {
      padding: 0.5rem 0.75rem;
      border: 1px solid var(--cd-border);
      border-radius: 0.5rem;
      font-size: 0.875rem;
      min-width: 220px;
    }
    .cd-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.375rem;
      padding: 0.5rem 0.9rem;
      border-radius: 0.5rem;
      font-size: 0.875rem;
      font-weight: 500;
      border: 1px solid var(--cd-border);
      background: var(--cd-surface);
      color: var(--cd-text);
      cursor: pointer;
      text-decoration: none;
    }
    .cd-btn:hover { background: #f8fafc; }
    .cd-btn-primary {
      background: var(--cd-primary);
      border-color: var(--cd-primary);
      color: #ffffff;
    }
    .cd-btn-primary:hover { background: var(--cd-primary-hover); }
    .cd-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.875rem;
    }
    .cd-table th, .cd-table td {
      text-align: left;
      padding: 0.75rem 0.875rem;
      border-bottom: 1px solid var(--cd-border);
      vertical-align: top;
    }
    .cd-table th {
      font-weight: 600;
      color: var(--cd-muted);
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
    .cd-badge {
      display: inline-flex;
      align-items: center;
      padding: 0.15rem 0.55rem;
      border-radius: 9999px;
      font-size: 0.75rem;
      font-weight: 600;
      text-transform: capitalize;
    }
    .cd-badge-new { background: var(--cd-new-bg); color: var(--cd-new-text); }
    .cd-badge-reviewed { background: var(--cd-reviewed-bg); color: var(--cd-reviewed-text); }
    .cd-badge-resolved { background: var(--cd-resolved-bg); color: var(--cd-resolved-text); }
    .cd-badge-dismissed { background: var(--cd-dismissed-bg); color: var(--cd-dismissed-text); }
    .cd-mono {
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      font-size: 0.8125rem;
      background: #f1f5f9;
      padding: 0.15rem 0.4rem;
      border-radius: 0.25rem;
    }
    .cd-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 1rem;
    }
    .cd-meta-list {
      margin: 0;
      display: grid;
      grid-template-columns: 140px 1fr;
      row-gap: 0.5rem;
      font-size: 0.875rem;
    }
    .cd-meta-list dt { color: var(--cd-muted); font-weight: 500; }
    .cd-meta-list dd { margin: 0; word-break: break-all; }
  </style>
</head>
<body>
  <header class="cd-header">
    <a class="cd-brand" href="<%= dashboard_feedbacks_path %>">
      <span>ContextDrop</span>
      <span class="cd-brand-badge">Feedback Triage</span>
    </a>
    <span style="font-size: 0.8125rem; color: var(--cd-muted);">v<%= ContextDrop::VERSION %></span>
  </header>

  <main class="cd-container">
    <% if flash[:notice].present? %>
      <div class="cd-flash cd-flash-notice"><%= flash[:notice] %></div>
    <% end %>
    <% if flash[:alert].present? %>
      <div class="cd-flash cd-flash-alert"><%= flash[:alert] %></div>
    <% end %>

    <%= yield %>
  </main>
</body>
</html>
