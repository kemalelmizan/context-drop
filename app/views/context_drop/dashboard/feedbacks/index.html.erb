<div class="cd-card cd-card-tight">
  <div class="cd-toolbar">
    <div class="cd-tabs" role="tablist" aria-label="Filter feedback by status">
      <% all_count = @status_counts["all"] || 0 %>
      <a href="<%= dashboard_feedbacks_path(q: @search_query.presence, page_url: @page_url_filter.presence) %>"
         class="cd-tab <%= 'active' if @current_status.blank? %>">
        <span>All</span>
        <span class="cd-tab-count <%= 'is-zero' if all_count.zero? %>"><%= all_count %></span>
      </a>
      <% ContextDrop::Feedback::STATUSES.each do |status_name| %>
        <% count = @status_counts[status_name] || 0 %>
        <a href="<%= dashboard_feedbacks_path(status: status_name, q: @search_query.presence, page_url: @page_url_filter.presence) %>"
           class="cd-tab <%= 'active' if @current_status == status_name %>">
          <span><%= status_name.capitalize %></span>
          <span class="cd-tab-count <%= 'is-zero' if count.zero? %>"><%= count %></span>
        </a>
      <% end %>
      <span class="cd-tabs-sep" aria-hidden="true"></span>
      <% deleted_count = @status_counts["deleted"] || 0 %>
      <a href="<%= dashboard_feedbacks_path(status: 'deleted', q: @search_query.presence, page_url: @page_url_filter.presence) %>"
         class="cd-tab <%= 'active' if @current_status == 'deleted' %>">
        <span>Deleted</span>
        <span class="cd-tab-count <%= 'is-zero' if deleted_count.zero? %>"><%= deleted_count %></span>
      </a>
    </div>

    <form method="get" action="<%= dashboard_feedbacks_path %>" class="cd-filter-bar">
      <% if @current_status.present? %>
        <input type="hidden" name="status" value="<%= @current_status %>">
      <% end %>
      <div class="cd-input-wrap">
        <span class="cd-input-icon"><%= cd_icon_search(size: 14) %></span>
        <input type="search"
               name="q"
               value="<%= @search_query %>"
               placeholder="Search message, selector, or DOM text..."
               class="cd-input"
               aria-label="Search feedback">
      </div>
      <div class="cd-input-wrap">
        <span class="cd-input-icon"><%= cd_icon_link(size: 14) %></span>
        <input type="text"
               name="page_url"
               value="<%= @page_url_filter %>"
               placeholder="Filter by page URL (e.g. /checkout)"
               class="cd-input"
               aria-label="Filter by page URL">
      </div>
      <button type="submit" class="cd-btn cd-btn-primary">Filter</button>
      <% if @search_query.present? || @page_url_filter.present? || @current_status.present? %>
        <a href="<%= dashboard_feedbacks_path %>" class="cd-btn">Reset</a>
      <% end %>
    </form>
  </div>

  <% if @feedbacks.empty? %>
    <div style="color: var(--cd-muted); padding: 3rem 1.5rem; text-align: center;">
      <p style="margin: 0 0 0.5rem 0; font-size: 1rem; font-weight: 600; color: var(--cd-text);">No feedback matches current filters</p>
      <p style="margin: 0; font-size: 0.8125rem;">Try adjusting your search terms or clearing status filters.</p>
    </div>
  <% else %>
    <div class="cd-table-wrap">
      <table class="cd-table">
        <colgroup>
          <col class="cd-col-id">
          <col class="cd-col-status">
          <col class="cd-col-message">
          <col class="cd-col-url">
          <col class="cd-col-submitter">
          <col class="cd-col-created">
          <col class="cd-col-actions">
        </colgroup>
        <thead>
          <tr>
            <th class="cd-cell-id">ID</th>
            <th class="cd-cell-status">Status</th>
            <th class="cd-cell-message">Message &amp; Context</th>
            <th class="cd-cell-url">Page URL</th>
            <th class="cd-cell-submitter">Submitter</th>
            <th class="cd-cell-created">Created</th>
            <th class="cd-cell-actions">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @feedbacks.each do |fb| %>
            <tr id="feedback-row-<%= fb.id %>">
              <td class="cd-cell-id">
                <a href="<%= dashboard_feedback_path(fb) %>" class="cd-mono-id">#<%= fb.id %></a>
              </td>
              <td class="cd-cell-status">
                <span class="cd-badge cd-badge-<%= fb.status %>"><%= fb.status %></span>
                <% if fb.respond_to?(:deleted?) && fb.deleted? %>
                  <div style="margin-top: 0.25rem;">
                    <span class="cd-badge cd-badge-deleted">deleted</span>
                  </div>
                <% end %>
              </td>
              <td class="cd-cell-message">
                <a href="<%= dashboard_feedback_path(fb) %>" class="cd-message-link">
                  <% if fb.message.present? %>
                    <%= truncate(fb.message, length: 160) %>
                  <% else %>
                    <span style="color: var(--cd-muted); font-style: italic; font-weight: 400;">(No text message)</span>
                  <% end %>
                </a>
                <div class="cd-context-chips">
                  <% if fb.respond_to?(:environment) && fb.environment.present? %>
                    <span class="cd-context-chip" style="font-family: var(--cd-font-mono);" title="Environment: <%= fb.environment %>">
                      <%= fb.environment %>
                    </span>
                  <% end %>
                  <% if fb.attachments.size > 0 %>
                    <span class="cd-context-chip" title="<%= fb.attachments.size %> attachment(s)">
                      <%= cd_icon_attachment(size: 11) %>
                      <span><%= fb.attachments.size %></span>
                    </span>
                  <% end %>
                  <% if fb.comments.size > 0 %>
                    <span class="cd-context-chip" title="<%= fb.comments.size %> comment(s)">
                      <%= cd_icon_comment(size: 11) %>
                      <span><%= fb.comments.size %></span>
                    </span>
                  <% end %>
                  <% if fb.element_references.size > 0 %>
                    <span class="cd-context-chip" title="<%= fb.element_references.size %> element reference(s)">
                      <%= cd_icon_pin(size: 11) %>
                      <span><%= fb.element_references.size %></span>
                    </span>
                  <% end %>
                  <% fb.element_references.first(2).each do |el| %>
                    <code class="cd-selector-chip" title="<%= el.selector %>"><%= el.selector %></code>
                  <% end %>
                  <% if fb.element_references.size > 2 %>
                    <span style="font-size: 0.75rem; color: var(--cd-muted); font-variant-numeric: tabular-nums;">
                      +<%= fb.element_references.size - 2 %> more
                    </span>
                  <% end %>
                </div>
              </td>
              <td class="cd-cell-url">
                <% path, host = url_path_and_host(fb.page_url) %>
                <div class="cd-url-box">
                  <div class="cd-url-top">
                    <span class="cd-url-path"><%= format_breakable_text(path) %></span><% if fb.page_url.present? %><a href="<%= fb.page_url %>"
                         target="_blank"
                         rel="noopener noreferrer"
                         class="cd-icon-link"
                         title="Open <%= fb.page_url %> in new tab"
                         aria-label="Open <%= fb.page_url %> in new tab"><%= cd_icon_external_link(size: 12) %></a><% end %>
                  </div>
                  <% if host.present? %>
                    <span class="cd-url-host"><%= format_breakable_text(host) %></span>
                  <% end %>
                </div>
              </td>
              <td class="cd-cell-submitter">
                <% submitter_primary, submitter_secondary = split_submitter_label(fb.submitter_label) %>
                <div class="cd-submitter-box">
                  <span class="cd-submitter-icon"><%= cd_icon_user(size: 13) %></span>
                  <div class="cd-submitter-meta">
                    <span class="cd-submitter-primary"><%= format_breakable_text(submitter_primary) %></span>
                    <% if submitter_secondary.present? %>
                      <span class="cd-submitter-secondary"><%= format_breakable_text(submitter_secondary) %></span>
                    <% end %>
                  </div>
                </div>
              </td>
              <td class="cd-cell-created">
                <% if fb.created_at %>
                  <span><%= fb.created_at.strftime("%Y-%m-%d") %></span>
                  <span class="cd-created-time"><%= fb.created_at.strftime("%H:%M UTC") %></span>
                <% end %>
              </td>
              <td class="cd-cell-actions">
                <a href="<%= dashboard_feedback_path(fb) %>"
                   class="cd-btn cd-btn-icon"
                   title="Inspect feedback #<%= fb.id %>"
                   aria-label="Inspect feedback #<%= fb.id %>">
                  <span aria-hidden="true">🔍</span>
                </a>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <%
      per_page = ContextDrop::Dashboard::FeedbacksController::PER_PAGE
      start_idx = @total_filtered.zero? ? 0 : ((@page - 1) * per_page) + 1
      end_idx = [@page * per_page, @total_filtered].min
    %>
    <div class="cd-pagination-bar">
      <div class="cd-pagination-info">
        Showing <strong><%= start_idx %>–<%= end_idx %></strong> of <strong><%= @total_filtered %></strong> feedback<%= @total_filtered == 1 ? '' : 's' %>
      </div>
      <% if @total_pages > 1 %>
        <div class="cd-pagination-nav">
          <% if @page > 1 %>
            <a href="<%= dashboard_feedbacks_path(page: @page - 1, status: @current_status.presence, q: @search_query.presence, page_url: @page_url_filter.presence) %>"
               class="cd-btn cd-btn-sm">
              <%= cd_icon_arrow_left(size: 12) %> Previous
            </a>
          <% else %>
            <button class="cd-btn cd-btn-sm" disabled style="opacity: 0.4; cursor: not-allowed;">
              <%= cd_icon_arrow_left(size: 12) %> Previous
            </button>
          <% end %>
          <span style="font-size: 0.75rem; padding: 0 0.35rem; font-variant-numeric: tabular-nums;">
            Page <strong><%= @page %></strong> of <strong><%= @total_pages %></strong>
          </span>
          <% if @page < @total_pages %>
            <a href="<%= dashboard_feedbacks_path(page: @page + 1, status: @current_status.presence, q: @search_query.presence, page_url: @page_url_filter.presence) %>"
               class="cd-btn cd-btn-sm">
              Next <%= cd_icon_arrow_right(size: 12) %>
            </a>
          <% else %>
            <button class="cd-btn cd-btn-sm" disabled style="opacity: 0.4; cursor: not-allowed;">
              Next <%= cd_icon_arrow_right(size: 12) %>
            </button>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
