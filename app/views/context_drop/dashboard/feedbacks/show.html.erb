<div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.25rem;">
  <div style="display: flex; align-items: center; gap: 0.75rem;">
    <a href="<%= dashboard_feedbacks_path %>" class="cd-btn">&larr; Back to List</a>
    <h1 style="margin: 0; font-size: 1.25rem;">Feedback #<%= @feedback.id %></h1>
    <span class="cd-badge cd-badge-<%= @feedback.status %>"><%= @feedback.status %></span>
  </div>

  <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
    <% [
      ["reviewed", "Mark Reviewed"],
      ["resolved", "Mark Resolved"],
      ["dismissed", "Dismiss"]
    ].each do |target_status, label| %>
      <%= form_with url: dashboard_feedback_path(@feedback), method: :patch, local: true, style: "display: inline;" do %>
        <input type="hidden" name="status" value="<%= target_status %>">
        <button type="submit"
                class="cd-btn <%= 'cd-btn-primary' if target_status == 'resolved' %>"
                <%= "disabled" if @feedback.status == target_status %>>
          <%= label %>
        </button>
      <% end %>
    <% end %>
  </div>
</div>

<div class="cd-card">
  <h2 style="margin-top: 0; font-size: 1rem; color: var(--cd-muted);">Feedback Message</h2>
  <p style="font-size: 1rem; white-space: pre-wrap; margin: 0 0 1.25rem 0;"><%= @feedback.message.presence || "(No message text provided)" %></p>

  <dl class="cd-meta-list">
    <dt>Page URL</dt>
    <dd><code class="cd-mono"><%= @feedback.page_url %></code></dd>
    <dt>Submitter</dt>
    <dd><%= @feedback.submitter_label %></dd>
    <dt>Submitted At</dt>
    <dd><%= @feedback.created_at&.iso8601 %></dd>
    <dt>User Agent</dt>
    <dd><%= @feedback.user_agent.presence || "N/A" %></dd>
    <dt>Metadata</dt>
    <dd><code class="cd-mono"><%= JSON.generate(@feedback.metadata || {}) %></code></dd>
  </dl>
</div>

<div class="cd-card">
  <h2 style="margin-top: 0; font-size: 1rem;">
    DOM Element References (<%= @feedback.element_references.size %>)
  </h2>

  <% if @feedback.element_references.empty? %>
    <p style="color: var(--cd-muted); margin: 0;">No DOM elements were selected for this submission.</p>
  <% else %>
    <div class="cd-grid">
      <% @feedback.element_references.each do |el| %>
        <div style="border: 1px solid var(--cd-border); border-radius: 0.5rem; padding: 1rem;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
            <code class="cd-mono">&lt;<%= el.tag_name %>&gt;</code>
            <% if el.captured_at %>
              <span style="font-size: 0.75rem; color: var(--cd-muted);"><%= el.captured_at.iso8601 %></span>
            <% end %>
          </div>
          <dl class="cd-meta-list">
            <dt>Selector</dt>
            <dd><code class="cd-mono"><%= el.selector %></code></dd>
            <dt>DOM Path</dt>
            <dd><code class="cd-mono"><%= el.dom_path.presence || "N/A" %></code></dd>
            <dt>Text Content</dt>
            <dd><%= el.text_content.presence || "(empty)" %></dd>
            <dt>Bounding Rect</dt>
            <dd><code class="cd-mono"><%= JSON.generate(el.bounding_rect || {}) %></code></dd>
            <dt>Viewport</dt>
            <dd><code class="cd-mono"><%= JSON.generate(el.viewport || {}) %></code></dd>
            <dt>Attributes</dt>
            <dd><code class="cd-mono"><%= JSON.generate(el.attributes_snapshot || {}) %></code></dd>
          </dl>
        </div>
      <% end %>
    </div>
  <% end %>
</div>

<div class="cd-card">
  <h2 style="margin-top: 0; font-size: 1rem;">
    Screenshots &amp; Attachments (<%= @feedback.attachments.size %>)
  </h2>

  <% if @feedback.attachments.empty? %>
    <p style="color: var(--cd-muted); margin: 0;">No binary attachments or screenshots were included.</p>
  <% else %>
    <div class="cd-grid">
      <% @feedback.attachments.each do |att| %>
        <div style="border: 1px solid var(--cd-border); border-radius: 0.5rem; padding: 1rem;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
            <span class="cd-badge cd-badge-new"><%= att.attachment_type %></span>
            <% if att.element_reference %>
              <span style="font-size: 0.75rem; color: var(--cd-muted);">
                Element: <code class="cd-mono"><%= att.element_reference.selector %></code>
              </span>
            <% end %>
          </div>

          <% if att.respond_to?(:file) && att.file.attached? %>
            <div style="margin: 0.5rem 0;">
              <% if main_app.respond_to?(:url_for) %>
                <img src="<%= main_app.url_for(att.file) %>"
                     alt="Attachment #<%= att.id %>"
                     style="max-width: 100%; border-radius: 0.375rem; border: 1px solid var(--cd-border);" />
              <% end %>
            </div>
            <div style="font-size: 0.75rem; color: var(--cd-muted);">
              <%= att.file.filename %> (<%= att.file.content_type %>, <%= att.file.byte_size %> bytes)
            </div>
          <% end %>

          <div style="margin-top: 0.5rem;">
            <code class="cd-mono"><%= JSON.generate(att.metadata || {}) %></code>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
